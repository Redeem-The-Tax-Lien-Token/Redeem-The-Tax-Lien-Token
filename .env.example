# wholesale-brrrr-system — root .env.example
# Copy this to .env for local development ONLY.
# In production (Replit), add these as Replit Secrets — never commit real values.

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Internal agent-to-agent auth ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=

# ── AI ─────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── Property data ─────────────────────────────────────────────────────────────
ATTOM_API_KEY=

# ── Street View (arv-mao only) ────────────────────────────────────────────────
# Street View Static API — must be enabled on the GCP project.
GOOGLE_MAPS_API_KEY=

# ── Skip trace ────────────────────────────────────────────────────────────────
TRACERFY_API_KEY=

# ── SMS ───────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=         # Your registered 10DLC number, e.g. +13175550100

# ── Agent URLs (fill in after each Repl is deployed) ─────────────────────────
ARV_MAO_URL=
INTAKE_URL=
LIST_PULLER_URL=
SKIP_TRACER_URL=
OUTREACH_URL=
DEAL_MARKETING_URL=
CRM_DASHBOARD_URL=

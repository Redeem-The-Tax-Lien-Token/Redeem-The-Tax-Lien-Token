# wholesale-brrrr-system — root .env.example
# Copy this to .env for local development ONLY.
# In production (Replit), add these as Replit Secrets — never commit real values.

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Internal agent-to-agent auth ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Set the SAME value in every agent's Replit Secrets before rotating.
INTERNAL_API_KEY=

# ── System mode ───────────────────────────────────────────────────────────────
# Set to "dry_run" to route all outbound SMS, money actions, and API calls to
# the log instead of executing them. New agents ship in dry_run first.
SYSTEM_MODE=dry_run

# ── AI ─────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# Model tier vars (never hard-code model IDs in agent code)
CLAUDE_MODEL_REASONING=claude-opus-5          # ARV, repair estimates, decision memos, orchestrator
CLAUDE_MODEL_FAST=claude-sonnet-5             # Intake, message drafting, ranking
CLAUDE_MODEL_CHEAP=claude-haiku-4-5-20251001  # Bulk tagging, summaries

# ── Property data ─────────────────────────────────────────────────────────────
ATTOM_API_KEY=

# ── Street View (arv-mao only) ────────────────────────────────────────────────
# Street View Static API — must be enabled on the GCP project.
GOOGLE_MAPS_API_KEY=

# ── Skip trace ────────────────────────────────────────────────────────────────
TRACERFY_API_KEY=

# ── SMS — Twilio A2P 10DLC ────────────────────────────────────────────────────
# IMPORTANT: all SMS sends must use messaging_service_sid, NOT from_=.
# A2P 10DLC requires a registered Messaging Service for local-number campaigns.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=    # e.g. MG_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Agent URLs (fill in after each Repl is deployed) ─────────────────────────
ARV_MAO_URL=
INTAKE_URL=
LIST_PULLER_URL=
SKIP_TRACER_URL=
OUTREACH_URL=
DEAL_MARKETING_URL=
CRM_DASHBOARD_URL=

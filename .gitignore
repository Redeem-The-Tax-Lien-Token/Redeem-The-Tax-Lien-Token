# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment / secrets — NEVER commit real values ──────────────────────────
.env
.env.local
.env.*.local
# Allow .env.example files (they contain only key names, never values)
!.env.example

# ── IDE / editors ──────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Replit runtime metadata (auto-generated per Repl; not committed) ───────────
# .replit IS committed — it configures the run command.
# These are runtime-generated and must not be checked in:
.pythonlibs/
.breakpoints
replit.nix

# ── Test / coverage ────────────────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
*.junit.xml

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
logs/
